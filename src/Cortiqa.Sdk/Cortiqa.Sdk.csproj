<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <PackageId>Cortiqa.Sdk</PackageId>
    <Version>0.1.1</Version>
    <Authors>Cortiqa AI Team</Authors>
    <Company>Cortiqa AI</Company>
    <Product>Cortiqa AI .NET SDK</Product>
    <Description>Official C# / .NET client library for Cortiqa AI and Falin Foundation Models. Supports ASP.NET Core, Windows Desktop, and Unity.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://cortiqa.co</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cortiqa-ai/cortiqa-sdk-csharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>cortiqa;ai;llm;falin;openai;anthropic;chat;streaming</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.5.4" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
